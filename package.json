{
  "name": "@connectonion/react",
  "version": "0.4.2-alpha.11",
  "description": "React hooks for ConnectOnion agents \u2014 useAgentForHuman, useVoiceInput, browser identity, and the agent connection itself",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/experimental/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./connect": {
      "types": "./dist/connect/index.d.ts",
      "default": "./dist/connect/index.js"
    },
    "./address-browser": {
      "types": "./dist/address-browser.d.ts",
      "default": "./dist/address-browser.js"
    },
    "./transcribe": {
      "types": "./dist/transcribe.d.ts",
      "default": "./dist/transcribe.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run build:compile",
    "build:compile": "tsc && tsc -p tsconfig.experimental.json",
    "pretest": "npm run build:compile",
    "test": "jest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.experimental.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "react",
    "hooks",
    "ai",
    "agent",
    "connectonion",
    "nextjs",
    "chat"
  ],
  "author": "ConnectOnion Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/openonion/connectonion-react"
  },
  "bugs": {
    "url": "https://github.com/openonion/connectonion-react/issues"
  },
  "homepage": "https://github.com/openonion/connectonion-react#readme",
  "dependencies": {
    "@scure/bip39": "1.6.0",
    "tweetnacl": "^1.0.3",
    "ws": "^8.18.0",
    "zustand": "^5.0.0"
  },
  "peerDependencies": {
    "react": ">=17.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.1",
    "@types/jest": "^29.0.0",
    "@types/react": "^18.0.0",
    "jest": "^29.0.0",
    "jest-environment-jsdom": "^30.2.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "ts-jest": "^29.0.0",
    "typescript": "^5.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "browser": {
    "fs": false,
    "path": false,
    "ws": false
  }
}
